# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://username:password@localhost:5432/restaurant_saas?schema=public"

# Authentication Security Secrets
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Minimum 32 chars; the server refuses to boot without a strong secret and
# there is intentionally no fallback. ROTATE on first hardened deploy: all
# previously issued tokens become invalid (new issuer/audience/version).
JWT_SECRET="your-super-secret-production-jwt-key-minimum-32-characters"
# Short-lived access token (12h) — tighter window after potential theft (H-02).
# Previous default 7d increased exposure; rotate JWT_SECRET after changing this.
JWT_EXPIRES_IN="12h"

# Backend Server Configuration
PORT=3001
VITE_API_URL="https://your-api-service.onrender.com"
NODE_ENV="production"
# Exact production origin(s), comma-separated. The server fails closed when
# this is empty in production (no CORS reflection, no fail-open).
CORS_ORIGIN="https://yourdomain.com"
APP_URL="https://yourdomain.com"
# Number of trusted reverse proxies (Render/Nginx = 1, direct = 0).
# Enables correct client IPs for rate limiting and auditing. NEVER set > 0
# on a directly exposed server (X-Forwarded-For spoofing).
TRUST_PROXY=0
# Content-Security-Policy frame-ancestors for API/SPA responses.
FRAME_ANCESTORS="'self'"

# Seed credentials (keep these only in the deployment secret manager)
PLATFORM_ADMIN_EMAIL="admin@example.com"
PLATFORM_ADMIN_PASSWORD="replace-with-a-strong-password"
MANAGER_1_NAME="Restaurant Manager 1"
MANAGER_1_EMAIL="manager1@example.com"
MANAGER_1_PASSWORD="replace-with-a-strong-password"
MANAGER_2_NAME="Restaurant Manager 2"
MANAGER_2_EMAIL="manager2@example.com"
MANAGER_2_PASSWORD="replace-with-a-strong-password"
MANAGER_3_NAME="Restaurant Manager 3"
MANAGER_3_EMAIL="manager3@example.com"
MANAGER_3_PASSWORD="replace-with-a-strong-password"

# Object Storage / Uploads
STORAGE_DRIVER="local" # local | s3 | supabase | cloudinary
UPLOAD_DIR="./uploads"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="eu-central-1"
AWS_S3_BUCKET=""

# Error Monitoring (Sentry)
SENTRY_DSN=""
