# PostgreSQL Database Connection URL
# For production security, use the unprivileged application user `mureeh_app` (provisioned via server/db/create_mureeh_app_user.sql)
# Do NOT use superuser or DDL owner credentials in production DATABASE_URL.
DATABASE_URL="postgresql://mureeh_app:password@localhost:5432/restaurant_saas?schema=public"


# Authentication Security Secrets
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Minimum 32 chars; the server refuses to boot without a strong secret and
# there is intentionally no fallback. ROTATE on first hardened deploy: all
# previously issued tokens become invalid (new issuer/audience/version).
JWT_SECRET="your-super-secret-production-jwt-key-minimum-32-characters"
# Short-lived access token (12h) — tighter window after potential theft (H-02).
# Previous default 7d increased exposure; rotate JWT_SECRET after changing this.
JWT_EXPIRES_IN="12h"

# Backend Server Configuration
PORT=3001
VITE_API_URL="https://your-api-service.onrender.com"
NODE_ENV="production"
# Exact production origin(s), comma-separated. The server fails closed when
# this is empty in production (no CORS reflection, no fail-open).
CORS_ORIGIN="https://yourdomain.com"
APP_URL="https://yourdomain.com"
# Number of trusted reverse proxies (Render/Nginx = 1, direct = 0).
# Enables correct client IPs for rate limiting and auditing. NEVER set > 0
# on a directly exposed server (X-Forwarded-For spoofing).
TRUST_PROXY=0
# Content-Security-Policy frame-ancestors for API/SPA responses.
FRAME_ANCESTORS="'self'"

# Seed credentials (keep these only in the deployment secret manager)
PLATFORM_ADMIN_EMAIL="admin@example.com"
PLATFORM_ADMIN_PASSWORD="replace-with-a-strong-password"
MANAGER_1_NAME="Restaurant Manager 1"
MANAGER_1_EMAIL="manager1@example.com"
MANAGER_1_PASSWORD="replace-with-a-strong-password"
MANAGER_2_NAME="Restaurant Manager 2"
MANAGER_2_EMAIL="manager2@example.com"
MANAGER_2_PASSWORD="replace-with-a-strong-password"
MANAGER_3_NAME="Restaurant Manager 3"
MANAGER_3_EMAIL="manager3@example.com"
MANAGER_3_PASSWORD="replace-with-a-strong-password"

# Object Storage / Uploads
# - local    : process filesystem under UPLOAD_DIR (dev/test only; EPHEMERAL on
#              Render/Heroku and any container host).
# - supabase : persistent Supabase Storage bucket (S3-compatible API).
#              REQUIRED for production so images survive restart/redeploy/scale.
# - object   : alias for `supabase`.
#
# FAIL-CLOSED production rules (see server/config.ts):
#   * STORAGE_DRIVER=supabase with a missing SUPABASE_URL or
#     SUPABASE_SERVICE_ROLE_KEY  -> the server REFUSES to boot (no silent
#     fallback to local/ephemeral storage that later "loses" images).
#   * STORAGE_DRIVER=local in production -> the server REFUSES to boot unless
#     STORAGE_ALLOW_LOCAL_IN_PROD=true is set AND UPLOAD_DIR is a mounted
#     persistent volume.
# Use "local" for development only.
STORAGE_DRIVER="local" # local | supabase | object
UPLOAD_DIR="./uploads"

# Required for STORAGE_DRIVER=supabase. Create the bucket once in the Supabase
# dashboard as PUBLIC-read so guest menus load images without signed URLs;
# writes are protected by the service-role key, which is server-side ONLY and
# is NEVER shipped to the browser or exposed in any API response.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="restaurant-assets"

# Explicit self-hosted escape hatch: only set "true" when UPLOAD_DIR is a
# mounted persistent volume. Keep "false" (or unset) on Render.
STORAGE_ALLOW_LOCAL_IN_PROD="false"

# Scheduled database backups (crash/restart resilience). Off by default.
# Enable with BACKUP_ENABLED=true; requires DB_PASSWORD (or PGPASSWORD).
# Dumps are written to ./backups (chmod 600) — mount a persistent volume there
# or copy the dumps off-instance.
BACKUP_ENABLED=""
BACKUP_INTERVAL_HOURS="24"

# Error Monitoring (Sentry)
SENTRY_DSN=""

# Landing-page explainer video (optional)
# The SaaS landing page ships a self-rendered animated walkthrough, so it works
# with no external asset. Set this to swap in a real recording instead:
#   - YouTube:  https://www.youtube.com/watch?v=VIDEO_ID   (embedded privacy-enhanced)
#   - Vimeo:    https://vimeo.com/VIDEO_ID
#   - Direct:   https://cdn.yourdomain.com/mureeh-demo.mp4 (native <video>)
# Read at BUILD time by Vite, so rebuild after changing it. Leave empty to keep
# the built-in walkthrough.
VITE_DEMO_VIDEO_URL=""

# ---------------------------------------------------------------------------
# Seeding & provisioning credentials  (security audit 2026-09-09, finding C-02)
# ---------------------------------------------------------------------------
# Seed scripts no longer contain hardcoded passwords. Tenant manager accounts
# are provisioned from these variables and the seed FAILS CLOSED if a password
# is missing, shorter than 12 chars, or on the common-password denylist.
# Use a unique, randomly generated value per environment, e.g.
#   openssl rand -base64 24
PLATFORM_ADMIN_EMAIL=""
PLATFORM_ADMIN_PASSWORD=""

SHOQRAH_MANAGER_EMAIL=""
SHOQRAH_MANAGER_PASSWORD=""

GHOSN_MANAGER_EMAIL=""
GHOSN_MANAGER_PASSWORD=""

# Demo/sample tenants are NEVER seeded in production. Set to 1 only in local
# or staging environments to create the sample restaurants.
ALLOW_DEMO_SEED=""

# ---------------------------------------------------------------------------
# Reverse proxy  (security audit 2026-09-09, finding H-03)
# ---------------------------------------------------------------------------
# Number of trusted proxies in front of the app. Render/Heroku/single Nginx = 1.
# Direct exposure = 0. NEVER set this to `true`: that makes Express trust an
# attacker-supplied X-Forwarded-For chain, which forges the client IP used by
# every rate limiter and audit log entry.
TRUST_PROXY="1"
