# Test-only environment for the employee functional harness.
# Copy to `e2e/server.env` and adjust the connection string for your machine:
#   cp e2e/server.env.example e2e/server.env
# These values are throwaway test fixtures — NEVER use them in production.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/mureeh_test?schema=public
JWT_SECRET=employee-functional-test-secret-key-change-me-32chars-min
JWT_EXPIRES_IN=12h
CORS_ORIGIN=
UPLOAD_DIR=./uploads
STORAGE_DRIVER=local
TRUST_PROXY=0
FRAME_ANCESTORS="'self'"
