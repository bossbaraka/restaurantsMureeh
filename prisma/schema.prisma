datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TenantRole {
  PLATFORM_ADMIN
  SUPER_ADMIN
  RESTAURANT_MANAGER
  STAFF
  WAITER
  KITCHEN
  CASHIER
}

enum RestaurantStatus {
  ACTIVE
  SUSPENDED
  ONBOARDING
  MAINTENANCE
}

// Kind of venue. Drives how the guest-facing QR experience is composed
// (dine-in table flow vs. counter/takeaway flow vs. product discovery),
// so it is tenant data rather than something inferred at render time.
enum BusinessType {
  RESTAURANT
  CAFE
  BAKERY
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  PAST_DUE
  CANCELLED
  SUSPENDED
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  BILL_REQUESTED
  RESERVED
  MAINTENANCE
}

enum TableZone {
  MAIN_HALL
  TERRACE
  VIP_LOUNGE
  GARDEN
}

enum WaiterRequestStatus {
  PENDING
  ACKNOWLEDGED
  RESOLVED
  CANCELLED
}

model Restaurant {
  id              String            @id @default(uuid())
  name            String
  nameEn          String            @default("")
  slug            String            @unique
  // IMAGE PERSISTENCE CONTRACT (single source of truth for theme assets)
  // ------------------------------------------------------------------
  // The image columns below store a STABLE REFERENCE, never a transient
  // one. Valid stored forms:
  //   1. the driver's object key — `restaurants/{restaurantId}/{folder}/
  //      {uuid}{ext}` (built by buildStorageKey; tenant-scoped) — the
  //      canonical form for every asset uploaded through
  //      POST /api/uploads/image;
  //   2. an absolute http(s) URL for external assets (CDN/Unsplash/…).
  // NEVER stored: blob:/data: payloads, `/uploads/…` URLs, Supabase
  // public URLs, or any value embedding the API's host name. On write
  // the branding route folds managed URLs back into their key
  // (normalizeAssetReference); on read every route resolves the stored
  // reference to a renderable URL through the single contract in
  // server/services/storage/resolve.ts (resolveRestaurantAssets) and
  // returns the pair as `logoUrl` + `logoStoragePath` (and the cover /
  // map / gallery equivalents). `logoUrl = ''` means "no logo" (the
  // column is NOT NULL); an explicit clear writes '', an omitted field
  // leaves the column untouched.
  logoUrl         String
  // How the uploaded logo is framed inside its fixed box (customer header,
  // manager sidebar, print menu). `logoFit` chooses crop vs. fit-whole;
  // `logoPosition` is a CSS object-position anchor so wide/tall logos stay
  // centered on their focal point instead of being cut awkwardly.
  logoFit         String            @default("cover")
  logoPosition    String            @default("50% 50%")
  coverImageUrl   String?
  description     String
  phone           String
  address         String
  currency        String            @default("₪")
  language        String            @default("ar")
  timezone        String            @default("Asia/Jerusalem")
  status          RestaurantStatus  @default(ACTIVE)
  businessType    BusinessType      @default(RESTAURANT)
  primaryColor    String            @default("#D4AF37")
  accentColor     String            @default("#C5A880")
  promoVideoUrl   String?
  galleryImages   String[]          @default([])
  latitude        Float?
  longitude       Float?
  mapUrl          String?
  // Static map/location image the venue can upload to show guests where it
  // is without embedding an external (Google Maps) frame.
  mapImageUrl     String?
  customDomain    String?
  planId          String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  users           RestaurantUser[]
  subscription    Subscription?
  categories      Category[]
  products        Product[]
  tables          Table[]
  tableSessions   TableSession[]
  orders          Order[]
  waiterRequests  WaiterRequest[]
  offers          Offer[]
  auditLogs       AuditLog[]
  branches        Branch[]
  payments        Payment[]

  @@index([slug])
  @@index([status])
  @@index([businessType])
}

model RestaurantUser {
  id              String            @id @default(uuid())
  restaurantId    String?
  restaurant      Restaurant?       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name            String
  email           String            @unique
  passwordHash    String
  pinHash         String?
  // Incremented on logout / password / PIN / role changes to revoke
  // previously issued JWTs (their `tv` claim no longer matches).
  tokenVersion    Int               @default(0)
  role            TenantRole        @default(RESTAURANT_MANAGER)
  status          String            @default("ACTIVE")
  avatar          String?
  // Last successful sign-in (email+password or staff PIN). Stays null until
  // the first login. Both auth routes write it — without the column, the
  // Prisma write throws and the staff PIN login fails with a 500.
  lastLoginAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  auditLogs       AuditLog[]

  @@index([email])
  @@index([restaurantId])
}

model Plan {
  id              String            @id
  name            String
  nameEn          String
  priceMonthly    Float             @default(0)
  priceYearly     Float             @default(0)
  billingPeriod   String            @default("monthly")
  maxTables       Int               @default(50)
  maxCategories   Int               @default(20)
  maxProducts     Int               @default(150)
  // Hard ceiling on physical locations (branches). Each branch carries real
  // hosting/QR/print cost, so even the enterprise plan is finite instead of
  // "unlimited" — it caps platform spend rather than letting it grow without
  // bound.
  maxBranches     Int               @default(3)
  entitlements    String[]          @default([])
  description     String
  status          String            @default("ACTIVE")
  isPopular       Boolean           @default(false)
  createdAt       DateTime          @default(now())

  subscriptions   Subscription[]
}

model Subscription {
  id                  String              @id @default(uuid())
  restaurantId        String              @unique
  restaurant          Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  planId              String
  plan                Plan                @relation(fields: [planId], references: [id])
  status              SubscriptionStatus  @default(ACTIVE)
  currentPeriodStart  DateTime            @default(now())
  currentPeriodEnd    DateTime
  trialEndsAt         DateTime?
  cancelAtPeriodEnd   Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([restaurantId])
  @@index([status])
}

model Table {
  id              String            @id @default(uuid())
  restaurantId    String
  restaurant      Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  number          Int
  name            String?
  capacity        Int               @default(4)
  zone            TableZone         @default(MAIN_HALL)
  status          TableStatus       @default(AVAILABLE)
  qrToken         String            @unique @default(uuid())
  hasWaiterCall   Boolean           @default(false)
  lastActivityAt  DateTime?
  branchId        String?
  branch          Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  sessions        TableSession[]
  orders          Order[]
  waiterRequests  WaiterRequest[]

  @@unique([restaurantId, number])
  @@index([restaurantId])
  @@index([status])
  @@index([qrToken])
}

model TableSession {
  id              String            @id @default(uuid())
  restaurantId    String
  restaurant      Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableId         String
  table           Table             @relation(fields: [tableId], references: [id], onDelete: Cascade)
  sessionToken    String            @unique @default(uuid())
  status          String            @default("ACTIVE") // ACTIVE or CLOSED
  startedAt       DateTime          @default(now())
  endedAt         DateTime?
  expiresAt       DateTime
  createdAt       DateTime          @default(now())

  orders          Order[]
  waiterRequests  WaiterRequest[]

  @@index([restaurantId])
  @@index([tableId])
  @@index([sessionToken])
}

model Category {
  id              String            @id @default(uuid())
  restaurantId    String
  restaurant      Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name            String
  nameEn          String?
  description     String?
  image           String?
  icon            String?
  sortOrder       Int               @default(0)
  status          String            @default("ACTIVE")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  products        Product[]

  @@index([restaurantId])
  @@index([sortOrder])
}

model Product {
  id                      String            @id @default(uuid())
  restaurantId            String
  restaurant              Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId              String
  category                Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name                    String
  nameEn                  String
  description             String
  price                   Float
  imageUrl                String
  available               Boolean           @default(true)
  isFeatured              Boolean           @default(false)
  badge                   String?
  preparationTimeMinutes  Int?              @default(15)
  calories                Int?
  allergens               String[]          @default([])
  ingredients             String[]          @default([])
  removableIngredients    String[]          @default([])
  sortOrder               Int               @default(0)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  options                 ProductOption[]
  addOns                  AddOn[]
  orderItems              OrderItem[]

  @@index([restaurantId])
  @@index([categoryId])
  @@index([available])
}

model ProductOption {
  id            String      @id @default(uuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String
  nameEn        String?
  price         Float       @default(0)
  priceModifier Float       @default(0)
  required      Boolean     @default(false)

  @@index([productId])
}

model AddOn {
  id            String      @id @default(uuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String
  nameEn        String?
  price         Float       @default(0)
  isAvailable   Boolean     @default(true)

  @@index([productId])
}

model Order {
  id                    String            @id
  numericId             Int               @default(autoincrement())
  restaurantId          String
  restaurant            Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableId               String
  table                 Table             @relation(fields: [tableId], references: [id], onDelete: Cascade)
  sessionId             String?
  session               TableSession?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  // Client-generated UUID makes customer order submission safely replayable
  // after a timeout/response loss without creating a second kitchen ticket.
  clientRequestId       String             @default(dbgenerated("gen_random_uuid()"))
  status                OrderStatus       @default(PENDING)
  paymentMethod         String            @default("PAY AT CASHIER")
  // UNPAID | PENDING_VERIFICATION | PAID
  //   UNPAID               → collectable at the cashier (default)
  //   PENDING_VERIFICATION → the guest uploaded a transfer receipt; a cashier
  //                          must confirm or reject it (still not money)
  //   PAID                 → settled; `settledAt`/`cashierId` say when/by whom
  // Rejection deliberately returns the order to UNPAID (with paymentRejectedAt
  // set) instead of introducing a fourth *collectable-adjacent* state: every
  // existing collect query in the POS filters on 'UNPAID', so a rejected order
  // stays collectable in cash with zero changes to the money paths.
  paymentStatus         String            @default("UNPAID")
  settledAt             DateTime?
  cashierId             String?
  branchId              String?
  // ---------------------------------------------------------------
  // Transfer payment proof (temporary operational data — see docs).
  // ---------------------------------------------------------------
  // Guest name as typed on the transfer notice. OPERATIONAL ONLY: it exists so
  // the cashier can match the receipt to the order (and reach the guest), it is
  // never an account/credential, and it is purged with the receipt after the
  // retention window. Never returned by the generic orders list — only by the
  // cashier verification queue.
  customerName          String?
  // Guest phone. OPERATIONAL ONLY: never an account, never a credential,
  // purged with the receipt after the retention window.
  customerPhone         String?
  // How the guest says they moved the money: BANK (bank transfer) or WALLET
  // (e-wallet). A display/operational hint for the cashier checking the
  // receipt — never a financial value and never trusted for settlement.
  transferChannel       String?
  // Object key in the PRIVATE storage namespace (never a public URL):
  // `restaurants/{restaurantId}/payment-proofs/{orderId}/{uuid}{ext}`.
  paymentProofPath      String?
  // Rejection marker: the guest sees "receipt rejected" while the order itself
  // is UNPAID again. Never used for authorization or for money.
  paymentRejectedAt     DateTime?
  paymentRejectionReason String?
  // ---------------------------------------------------------------
  // Fulfillment gate — THE payment authorization boundary.
  // ---------------------------------------------------------------
  // The single server-side answer to "may the restaurant execute this order?".
  // While it is anything other than RELEASED the order is refused by the
  // service API (PUT /orders/:id/status) and every operational screen (KDS,
  // live floor) filters it out; it becomes operational only when a cashier
  // verifies the money. Values (TEXT, application-level, like paymentStatus):
  //   AWAITING_PAYMENT             → the guest submitted the order and has not
  //                                  sent payment information yet
  //   PAYMENT_VERIFICATION_PENDING → a receipt is queued for a cashier decision
  //   PAYMENT_REJECTED             → the cashier refused the receipt; the guest
  //                                  must respond (new receipt / pay in person)
  //   RELEASED                     → payment verified (cashier confirmation or
  //                                  collection at the till), or the order was
  //                                  created by staff at the POS where the money
  //                                  is taken in person
  // Default RELEASED is deliberate: every pre-gate row (and any process still
  // running the previous build) keeps exactly the operational behaviour it has
  // today, so the migration cannot hide or strand existing orders.
  fulfillmentState      String            @default("RELEASED")
  // When the gate opened. Written in the SAME transaction as the payment claim
  // that released the order, so "paid" and "released" can never disagree.
  releasedAt            DateTime?
  // ---------------------------------------------------------------
  // Daily archive / retention (financial history is NEVER removed).
  // ---------------------------------------------------------------
  // Set once the tenant-local business session this order belongs to has
  // closed (see server/services/retention.ts). A marker, not a copy: the
  // order keeps every financial attribute for reconciliation and reporting.
  archivedAt            DateTime?
  // Set when the temporary operational data of an archived order (phone +
  // private receipt image) has been purged. Makes cleanup idempotent and
  // answers "was this order's temporary data already removed?".
  retentionPurgedAt     DateTime?
  subtotal              Float
  tax                   Float             @default(0)
  total                 Float
  notes                 String?
  estimatedPrepMinutes  Int?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  items                 OrderItem[]

  @@unique([restaurantId, clientRequestId])
  @@index([restaurantId])
  @@index([tableId])
  @@index([status])
  @@index([createdAt])
  // Cashier "pending transfer verification" queue.
  @@index([restaurantId, paymentStatus])
  // Operational screens ("what may the restaurant execute right now?") and the
  // cashier's waiting-for-payment list.
  @@index([restaurantId, fulfillmentState])
  // Retention sweep: global scan of archived, not-yet-purged orders.
  @@index([archivedAt])
}

model OrderItem {
  id                    String      @id @default(uuid())
  orderId               String
  order                 Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId             String?
  product               Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNameSnapshot   String
  productNameEnSnapshot String?
  priceSnapshot         Float
  quantity              Int         @default(1)
  selectedSize          String?
  selectedAddOns        String[]    @default([])
  removedIngredients    String[]    @default([])
  specialInstructions   String?
  notes                 String?
  totalPrice            Float

  @@index([orderId])
  @@index([productId])
}

model WaiterRequest {
  id            String              @id @default(uuid())
  restaurantId  String
  restaurant    Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableId       String
  table         Table               @relation(fields: [tableId], references: [id], onDelete: Cascade)
  sessionId     String?
  session       TableSession?       @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  reason        String              @default("ASSISTANCE")
  reasonText    String?
  status        WaiterRequestStatus @default(PENDING)
  createdAt     DateTime            @default(now())
  resolvedAt    DateTime?

  @@index([restaurantId])
  @@index([tableId])
  @@index([status])
}

model Offer {
  id                  String      @id @default(uuid())
  restaurantId        String
  restaurant          Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  title               String
  titleEn             String?
  subtitle            String?
  description         String?
  image               String?
  originalPrice       Float?
  discountedPrice     Float?
  discountPercentage  Float?
  badge               String?     @default("عرض خاص")
  bgGradient          String?
  isActive            Boolean     @default(true)
  code                String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([restaurantId])
  @@index([isActive])
}

model AuditLog {
  id            String          @id @default(uuid())
  restaurantId  String?
  restaurant    Restaurant?     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId        String?
  user          RestaurantUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  actor         String
  actorRole     TenantRole      @default(RESTAURANT_MANAGER)
  action        String
  entity        String?
  entityId      String?
  details       String
  metadata      Json?
  // Client IP resolved behind TRUST_PROXY (req.ip). Populated for
  // security-relevant events; nullable to keep older audit rows valid.
  ipAddress     String?
  createdAt     DateTime        @default(now())

  @@index([restaurantId])
  @@index([action])
  @@index([createdAt])
}


// ============================================
// Multi-Branch Management (Tenant Isolated)
// ============================================
model Branch {
  id           String      @id
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  address      String?
  phone        String?
  color        String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tables       Table[]

  @@index([restaurantId])
}

// ============================================
// Cashier / POS Payment Ledger (Tenant Isolated)
// ============================================
model Payment {
  id            String     @id
  receiptNumber String
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId      String?
  tableId       String     // physical table id or '__WALKIN__' for counter sales
  tableLabel    String
  orderIds      String[]
  itemsSummary  String?
  method        String     @default("CASH") // CASH | CARD | MOBILE | SPLIT
  subtotal      Float
  tax           Float      @default(0)
  total         Float
  cashReceived  Float?
  changeDue     Float?
  tip           Float?
  cashierId     String?
  cashierName   String
  note          String?
  createdAt     DateTime   @default(now())

  @@unique([restaurantId, receiptNumber])
  @@index([restaurantId])
  @@index([createdAt])
  @@index([method])
}
