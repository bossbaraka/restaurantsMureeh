datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TenantRole {
  PLATFORM_ADMIN
  SUPER_ADMIN
  RESTAURANT_MANAGER
  STAFF
  WAITER
  KITCHEN
  CASHIER
}

enum RestaurantStatus {
  ACTIVE
  SUSPENDED
  ONBOARDING
  MAINTENANCE
}

// Kind of venue. Drives how the guest-facing QR experience is composed
// (dine-in table flow vs. counter/takeaway flow vs. product discovery),
// so it is tenant data rather than something inferred at render time.
enum BusinessType {
  RESTAURANT
  CAFE
  BAKERY
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  PAST_DUE
  CANCELLED
  SUSPENDED
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  BILL_REQUESTED
  RESERVED
  MAINTENANCE
}

enum TableZone {
  MAIN_HALL
  TERRACE
  VIP_LOUNGE
  GARDEN
}

enum WaiterRequestStatus {
  PENDING
  ACKNOWLEDGED
  RESOLVED
  CANCELLED
}

model Restaurant {
  id              String            @id @default(uuid())
  name            String
  nameEn          String            @default("")
  slug            String            @unique
  // IMAGE PERSISTENCE CONTRACT (single source of truth for theme assets)
  // ------------------------------------------------------------------
  // The image columns below store a STABLE REFERENCE, never a transient
  // one. Valid stored forms:
  //   1. the driver's object key — `restaurants/{restaurantId}/{folder}/
  //      {uuid}{ext}` (built by buildStorageKey; tenant-scoped) — the
  //      canonical form for every asset uploaded through
  //      POST /api/uploads/image;
  //   2. an absolute http(s) URL for external assets (CDN/Unsplash/…).
  // NEVER stored: blob:/data: payloads, `/uploads/…` URLs, Supabase
  // public URLs, or any value embedding the API's host name. On write
  // the branding route folds managed URLs back into their key
  // (normalizeAssetReference); on read every route resolves the stored
  // reference to a renderable URL through the single contract in
  // server/services/storage/resolve.ts (resolveRestaurantAssets) and
  // returns the pair as `logoUrl` + `logoStoragePath` (and the cover /
  // map / gallery equivalents). `logoUrl = ''` means "no logo" (the
  // column is NOT NULL); an explicit clear writes '', an omitted field
  // leaves the column untouched.
  logoUrl         String
  // How the uploaded logo is framed inside its fixed box (customer header,
  // manager sidebar, print menu). `logoFit` chooses crop vs. fit-whole;
  // `logoPosition` is a CSS object-position anchor so wide/tall logos stay
  // centered on their focal point instead of being cut awkwardly.
  logoFit         String            @default("cover")
  logoPosition    String            @default("50% 50%")
  coverImageUrl   String?
  description     String
  phone           String
  address         String
  currency        String            @default("₪")
  language        String            @default("ar")
  timezone        String            @default("Asia/Jerusalem")
  status          RestaurantStatus  @default(ACTIVE)
  businessType    BusinessType      @default(RESTAURANT)
  primaryColor    String            @default("#D4AF37")
  accentColor     String            @default("#C5A880")
  promoVideoUrl   String?
  galleryImages   String[]          @default([])
  latitude        Float?
  longitude       Float?
  mapUrl          String?
  // Static map/location image the venue can upload to show guests where it
  // is without embedding an external (Google Maps) frame.
  mapImageUrl     String?
  // ------------------------------------------------------------------
  // CUSTOMER TRANSFER PAYMENT DETAILS (tenant-scoped receiving account)
  // ------------------------------------------------------------------
  // Where the guest sends the money when he pays by transfer. This is the
  // MIRROR IMAGE of the order's transfer proof: the proof says "I paid"
  // (Order.customerName/customerPhone/transferChannel + receipt image),
  // these columns say "pay HERE". They are venue settings, not financial
  // data: nothing here is ever read by the settlement path, the fulfillment
  // gate, the ledger (Payment) or the cashier's verification decision — the
  // cashier still verifies the money against the receipt, never against
  // these strings.
  //
  // Per-channel by design (the guest modal already offers BANK | WALLET):
  //   BANK   → transferBankName + transferBankAccount + transferBankAccountHolder
  //   WALLET → transferWalletName + transferWalletNumber + transferWalletAccountHolder
  //   both   → transferInstructions (optional free text, e.g. "write the
  //            table number in the transfer note")
  // `transferWalletNumber` is the wallet's phone number OR its account id —
  // deliberately NOT normalized as a customer phone (wallet identifiers are
  // not always phone numbers), only bounded and character-restricted.
  //
  // All seven are nullable: NULL means "this venue did not fill this in", and
  // the guest modal then shows a safe fallback instead of an empty card or a
  // fake value. Scope is the RESTAURANT (tenant), never a Branch — a guest
  // pays the venue, not a location. Public by nature (the equivalent of
  // printing the account on the table tent card), so they are exposed through
  // the existing guest catalog projection only.
  transferBankName           String?
  transferBankAccount        String?
  transferBankAccountHolder  String?
  transferWalletName         String?
  transferWalletNumber       String?
  transferWalletAccountHolder String?
  transferInstructions       String?
  // ------------------------------------------------------------------
  // CONTACT CHANNELS & RESERVATIONS (tenant-scoped, all optional)
  // ------------------------------------------------------------------
  // The venue's own public contact surface, entered once in
  // «الإعدادات ← التواصل والحجز» and read from ONE place:
  //   whatsappNumber  → the reservation CTA on the Live Menu screen and the
  //                     «تواصل معنا» section of the guest menu. It is the
  //                     venue's public business number (the equivalent of
  //                     printing it on the door), stored in canonical E.164
  //                     (`+` + digits) so the WhatsApp deep link can be built
  //                     without guessing a country code.
  //   *Url            → the social profile links shown in the guest menu's
  //                     «تواصل معنا» section. HTTPS-only, credential-free and
  //                     host-allowlisted per platform by the API validator, so
  //                     a `javascript:`/`data:` payload can never be stored
  //                     and rendered as an href.
  //
  // NULL means "this venue did not fill it in" — the UI then hides the channel
  // entirely (no empty icon, no dead reservation button). Scope is the
  // RESTAURANT (tenant), never a Branch: a guest reserves with the venue.
  whatsappNumber  String?
  instagramUrl    String?
  facebookUrl     String?
  tiktokUrl       String?
  youtubeUrl      String?
  websiteUrl      String?
  customDomain    String?
  planId          String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  users           RestaurantUser[]
  subscription    Subscription?
  categories      Category[]
  products        Product[]
  tables          Table[]
  tableSessions   TableSession[]
  orders          Order[]
  waiterRequests  WaiterRequest[]
  offers          Offer[]
  auditLogs       AuditLog[]
  branches        Branch[]
  payments        Payment[]

  @@index([slug])
  @@index([status])
  @@index([businessType])
}

model RestaurantUser {
  id              String            @id @default(uuid())
  restaurantId    String?
  restaurant      Restaurant?       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name            String
  // Authentication identity, per the 2026-09 employee auth redesign:
  //   * managers / platform staff authenticate with EMAIL + strong password;
  //   * shift staff (WAITER/KITCHEN/CASHIER/STAFF) authenticate with
  //     RESTAURANT CODE + USERNAME + 6-digit PIN via /api/auth/employee-login.
  // Email is therefore nullable: shift staff must never receive synthetic
  // emails (they used to be minted as auth identifiers — AUTH-01). Username
  // is unique within a tenant; the pair is enforced by the compound index.
  email           String?           @unique
  // Username identifiers (not secrets): lowercase [a-z0-9._-], 2-32 chars,
  // unique per restaurant. Nullable for legacy rows until migration.
  username        String?
  // bcrypt(12) — only usable by manager/platform roles (login route rejects
  // shift-staff password auth outright, so legacy derived hashes are inert).
  passwordHash    String
  // bcrypt(10) of an exactly-6-digit PIN. All legacy 4-digit PINs were
  // invalidated by the 20260919 migration (policy change; hashes are not
  // readable, so managers re-issue PINs from the staff screen).
  pinHash         String?
  // Per-account failure budget (AUTH-02): the IP limiter alone cannot stop
  // distributed guessing. Progressive lock, capped, reset on success.
  failedAuthCount Int               @default(0)
  authLockedUntil DateTime?
  lastAuthFailAt  DateTime?
  // Incremented on logout / password / PIN / role changes to revoke
  // previously issued JWTs (their `tv` claim no longer matches).
  tokenVersion    Int               @default(0)
  role            TenantRole        @default(RESTAURANT_MANAGER)
  status          String            @default("ACTIVE")
  avatar          String?
  // Last successful sign-in (email+password or staff PIN). Stays null until
  // the first login. Both auth routes write it — without the column, the
  // Prisma write throws and the staff PIN login fails with a 500.
  lastLoginAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  auditLogs       AuditLog[]

  @@index([email])
  @@index([restaurantId])
  @@unique([restaurantId, username])
  @@index([restaurantId, username])
}

model Plan {
  id              String            @id
  name            String
  nameEn          String
  priceMonthly    Float             @default(0)
  priceYearly     Float             @default(0)
  billingPeriod   String            @default("monthly")
  maxTables       Int               @default(50)
  maxCategories   Int               @default(20)
  maxProducts     Int               @default(150)
  // Hard ceiling on physical locations (branches). Each branch carries real
  // hosting/QR/print cost, so even the enterprise plan is finite instead of
  // "unlimited" — it caps platform spend rather than letting it grow without
  // bound.
  maxBranches     Int               @default(3)
  entitlements    String[]          @default([])
  description     String
  status          String            @default("ACTIVE")
  isPopular       Boolean           @default(false)
  createdAt       DateTime          @default(now())

  subscriptions   Subscription[]
}

model Subscription {
  id                  String              @id @default(uuid())
  restaurantId        String              @unique
  restaurant          Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  planId              String
  plan                Plan                @relation(fields: [planId], references: [id])
  status              SubscriptionStatus  @default(ACTIVE)
  currentPeriodStart  DateTime            @default(now())
  currentPeriodEnd    DateTime
  trialEndsAt         DateTime?
  cancelAtPeriodEnd   Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([restaurantId])
  @@index([status])
}

model Table {
  id              String            @id @default(uuid())
  restaurantId    String
  restaurant      Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  number          Int
  name            String?
  capacity        Int               @default(4)
  zone            TableZone         @default(MAIN_HALL)
  status          TableStatus       @default(AVAILABLE)
  qrToken         String            @unique @default(uuid())
  hasWaiterCall   Boolean           @default(false)
  lastActivityAt  DateTime?
  branchId        String?
  branch          Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  sessions        TableSession[]
  orders          Order[]
  waiterRequests  WaiterRequest[]

  @@unique([restaurantId, number])
  @@index([restaurantId])
  @@index([status])
  @@index([qrToken])
}

model TableSession {
  id              String            @id @default(uuid())
  restaurantId    String
  restaurant      Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableId         String
  table           Table             @relation(fields: [tableId], references: [id], onDelete: Cascade)
  sessionToken    String            @unique @default(uuid())
  status          String            @default("ACTIVE") // ACTIVE or CLOSED
  startedAt       DateTime          @default(now())
  endedAt         DateTime?
  expiresAt       DateTime
  createdAt       DateTime          @default(now())

  orders          Order[]
  waiterRequests  WaiterRequest[]

  @@index([restaurantId])
  @@index([tableId])
  @@index([sessionToken])
}

model Category {
  id              String            @id @default(uuid())
  restaurantId    String
  restaurant      Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name            String
  nameEn          String?
  description     String?
  image           String?
  icon            String?
  sortOrder       Int               @default(0)
  status          String            @default("ACTIVE")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  products        Product[]

  @@index([restaurantId])
  @@index([sortOrder])
}

model Product {
  id                      String            @id @default(uuid())
  restaurantId            String
  restaurant              Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId              String
  category                Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name                    String
  nameEn                  String
  description             String
  price                   Float
  imageUrl                String
  available               Boolean           @default(true)
  isFeatured              Boolean           @default(false)
  badge                   String?
  preparationTimeMinutes  Int?              @default(15)
  calories                Int?
  allergens               String[]          @default([])
  ingredients             String[]          @default([])
  removableIngredients    String[]          @default([])
  sortOrder               Int               @default(0)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  options                 ProductOption[]
  addOns                  AddOn[]
  orderItems              OrderItem[]

  @@index([restaurantId])
  @@index([categoryId])
  @@index([available])
}

model ProductOption {
  id            String      @id @default(uuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String
  nameEn        String?
  price         Float       @default(0)
  priceModifier Float       @default(0)
  required      Boolean     @default(false)

  @@index([productId])
}

model AddOn {
  id            String      @id @default(uuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String
  nameEn        String?
  price         Float       @default(0)
  isAvailable   Boolean     @default(true)

  @@index([productId])
}

model Order {
  id                    String            @id
  numericId             Int               @default(autoincrement())
  restaurantId          String
  restaurant            Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  // Null for counter (walk-in) orders: `orderSource = 'COUNTER'` orders are
  // created at the POS with no table. Table-service orders keep the FK.
  tableId               String?
  table                 Table?            @relation(fields: [tableId], references: [id], onDelete: Cascade)
  // 'TABLE' (QR/table service — default, matches every pre-existing row) or
  // 'COUNTER' (POS walk-in). Distinguishes the source without overloading
  // tableId with sentinel values (the old '__WALKIN__' literal caused FK 500s).
  orderSource           String            @default("TABLE")
  sessionId             String?
  session               TableSession?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  // Client-generated UUID makes customer order submission safely replayable
  // after a timeout/response loss without creating a second kitchen ticket.
  clientRequestId       String             @default(dbgenerated("gen_random_uuid()"))
  status                OrderStatus       @default(PENDING)
  paymentMethod         String            @default("PAY AT CASHIER")
  // UNPAID | PENDING_VERIFICATION | PAID
  //   UNPAID               → collectable at the cashier (default)
  //   PENDING_VERIFICATION → the guest uploaded a transfer receipt; a cashier
  //                          must confirm or reject it (still not money)
  //   PAID                 → settled; `settledAt`/`cashierId` say when/by whom
  // Rejection deliberately returns the order to UNPAID (with paymentRejectedAt
  // set) instead of introducing a fourth *collectable-adjacent* state: every
  // existing collect query in the POS filters on 'UNPAID', so a rejected order
  // stays collectable in cash with zero changes to the money paths.
  paymentStatus         String            @default("UNPAID")
  settledAt             DateTime?
  cashierId             String?
  branchId              String?
  // ---------------------------------------------------------------
  // Transfer payment proof (temporary operational data — see docs).
  // ---------------------------------------------------------------
  // Guest name as typed on the transfer notice. OPERATIONAL ONLY: it exists so
  // the cashier can match the receipt to the order (and reach the guest), it is
  // never an account/credential, and it is purged with the receipt after the
  // retention window. Never returned by the generic orders list — only by the
  // cashier verification queue.
  customerName          String?
  // Guest phone. OPERATIONAL ONLY: never an account, never a credential,
  // purged with the receipt after the retention window.
  customerPhone         String?
  // How the guest says they moved the money: BANK (bank transfer) or WALLET
  // (e-wallet). A display/operational hint for the cashier checking the
  // receipt — never a financial value and never trusted for settlement.
  transferChannel       String?
  // Object key in the PRIVATE storage namespace (never a public URL):
  // `restaurants/{restaurantId}/payment-proofs/{orderId}/{uuid}{ext}`.
  paymentProofPath      String?
  // Rejection marker: the guest sees "receipt rejected" while the order itself
  // is UNPAID again. Never used for authorization or for money.
  paymentRejectedAt     DateTime?
  paymentRejectionReason String?
  // ---------------------------------------------------------------
  // Fulfillment gate — THE payment authorization boundary.
  // ---------------------------------------------------------------
  // The single server-side answer to "may the restaurant execute this order?".
  // While it is anything other than RELEASED the order is refused by the
  // service API (PUT /orders/:id/status) and every operational screen (KDS,
  // live floor) filters it out; it becomes operational only when a cashier
  // verifies the money. Values (TEXT, application-level, like paymentStatus):
  //   AWAITING_PAYMENT             → the guest submitted the order and has not
  //                                  sent payment information yet
  //   PAYMENT_VERIFICATION_PENDING → a receipt is queued for a cashier decision
  //   PAYMENT_REJECTED             → the cashier refused the receipt; the guest
  //                                  must respond (new receipt / pay in person)
  //   RELEASED                     → payment verified (cashier confirmation or
  //                                  collection at the till), or the order was
  //                                  created by staff at the POS where the money
  //                                  is taken in person
  // Default RELEASED is deliberate: every pre-gate row (and any process still
  // running the previous build) keeps exactly the operational behaviour it has
  // today, so the migration cannot hide or strand existing orders.
  fulfillmentState      String            @default("RELEASED")
  // When the gate opened. Written in the SAME transaction as the payment claim
  // that released the order, so "paid" and "released" can never disagree.
  releasedAt            DateTime?
  // --------------------------------------------------------------- 
  // Staff cancellation marker (audit H-02). `status = CANCELLED` remains the
  // single operational truth; these nullable columns answer when/why/by whom
  // a staff member cancelled the order. Money guard: the API refuses to
  // cancel a PAID order (the receipt must be voided first, Payment.voidedAt).
  // -----------------------------------------------------------------
  cancelledAt           DateTime?
  cancelReason          String?
  cancelledByUserId     String?
  // ---------------------------------------------------------------
  // Daily archive / retention (financial history is NEVER removed).
  // ---------------------------------------------------------------
  // Set once the tenant-local business session this order belongs to has
  // closed (see server/services/retention.ts). A marker, not a copy: the
  // order keeps every financial attribute for reconciliation and reporting.
  archivedAt            DateTime?
  // Set when the temporary operational data of an archived order (phone +
  // private receipt image) has been purged. Makes cleanup idempotent and
  // answers "was this order's temporary data already removed?".
  retentionPurgedAt     DateTime?
  subtotal              Float
  tax                   Float             @default(0)
  total                 Float
  notes                 String?
  estimatedPrepMinutes  Int?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  items                 OrderItem[]

  @@unique([restaurantId, clientRequestId])
  @@index([restaurantId])
  @@index([tableId])
  @@index([status])
  @@index([createdAt])
  // Cashier "pending transfer verification" queue.
  @@index([restaurantId, paymentStatus])
  // Operational screens ("what may the restaurant execute right now?") and the
  // cashier's waiting-for-payment list.
  @@index([restaurantId, fulfillmentState])
  // Retention sweep: global scan of archived, not-yet-purged orders.
  @@index([archivedAt])
}

model OrderItem {
  id                    String      @id @default(uuid())
  orderId               String
  order                 Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId             String?
  product               Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNameSnapshot   String
  productNameEnSnapshot String?
  priceSnapshot         Float
  quantity              Int         @default(1)
  selectedSize          String?
  selectedAddOns        String[]    @default([])
  removedIngredients    String[]    @default([])
  specialInstructions   String?
  notes                 String?
  totalPrice            Float

  @@index([orderId])
  @@index([productId])
}

model WaiterRequest {
  id            String              @id @default(uuid())
  restaurantId  String
  restaurant    Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableId       String
  table         Table               @relation(fields: [tableId], references: [id], onDelete: Cascade)
  sessionId     String?
  session       TableSession?       @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  reason        String              @default("ASSISTANCE")
  reasonText    String?
  status        WaiterRequestStatus @default(PENDING)
  createdAt     DateTime            @default(now())
  resolvedAt    DateTime?

  @@index([restaurantId])
  @@index([tableId])
  @@index([status])
}

model Offer {
  id                  String      @id @default(uuid())
  restaurantId        String
  restaurant          Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  title               String
  titleEn             String?
  subtitle            String?
  description         String?
  image               String?
  originalPrice       Float?
  discountedPrice     Float?
  discountPercentage  Float?
  badge               String?     @default("عرض خاص")
  bgGradient          String?
  isActive            Boolean     @default(true)
  code                String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([restaurantId])
  @@index([isActive])
}

model AuditLog {
  id            String          @id @default(uuid())
  restaurantId  String?
  restaurant    Restaurant?     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId        String?
  user          RestaurantUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  actor         String
  actorRole     TenantRole      @default(RESTAURANT_MANAGER)
  action        String
  entity        String?
  entityId      String?
  details       String
  metadata      Json?
  // Client IP resolved behind TRUST_PROXY (req.ip). Populated for
  // security-relevant events; nullable to keep older audit rows valid.
  ipAddress     String?
  createdAt     DateTime        @default(now())

  @@index([restaurantId])
  @@index([action])
  @@index([createdAt])
}


// ============================================
// Multi-Branch Management (Tenant Isolated)
// ============================================
model Branch {
  id           String      @id
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  address      String?
  phone        String?
  color        String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tables       Table[]

  @@index([restaurantId])
}

// ============================================
// Cashier / POS Payment Ledger (Tenant Isolated)
// ============================================
model Payment {
  id            String     @id
  receiptNumber String
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId      String?
  tableId       String     // physical table id or '__WALKIN__' for counter sales
  tableLabel    String
  orderIds      String[]
  itemsSummary  String?
  method        String     @default("CASH") // CASH | CARD | MOBILE | SPLIT
  subtotal      Float
  tax           Float      @default(0)
  total         Float
  cashReceived  Float?
  changeDue     Float?
  tip           Float?
  cashierId     String?
  cashierName   String
  note          String?
  // Payment void marker (audit H-02): the receipt row is an immutable ledger
  // entry — voiding MARKS it (never deletes/rewrites amounts) and the covered
  // orders are reverted to UNPAID/AWAITING_PAYMENT in the same transaction.
  voidedAt      DateTime?
  voidReason    String?
  voidedByUserId String?
  createdAt     DateTime   @default(now())

  @@unique([restaurantId, receiptNumber])
  @@index([restaurantId])
  @@index([createdAt])
  @@index([method])
  @@index([restaurantId, voidedAt])
}
